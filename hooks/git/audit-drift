#!/usr/bin/env bash
# Mechanical drift checks for golden paths. Prints a markdown report; changes nothing.
# Usage: audit-drift [--previous FILE] [--fail-on-drift]
set -eu
lib=${RASTRO_LIB:-$(dirname "$0")/../lib}
. "$lib/config.sh"
. "$lib/frontmatter.sh"
. "$lib/goldenpath.sh"
. "$lib/metrics.sh"

previous=""
fail_on_drift=0
while [ "$#" -gt 0 ]; do
  case $1 in
    --previous)
      if [ "$#" -lt 2 ]; then
        echo "audit-drift: --previous needs a file" >&2
        exit 2
      fi
      previous=$2
      shift 2
      ;;
    --fail-on-drift)
      fail_on_drift=1
      shift
      ;;
    *)
      echo "audit-drift: unknown option: $1" >&2
      echo "usage: audit-drift [--previous FILE] [--fail-on-drift]" >&2
      exit 2
      ;;
  esac
done

root=$(rastro_root)
RASTRO_CONFIG=$(rastro_config_path) || {
  echo "audit-drift: no .rastro/config.yml in $root" >&2
  exit 2
}
export RASTRO_CONFIG
cd "$root"

rows=""
drifts=0
row() {
  local detail=${4//|//}
  rows=$rows"| $1 | $2 | $3 | $detail |"$'\n'
  [ "$3" != drift ] || drifts=$((drifts + 1))
}

shallow=false
git rev-parse --is-shallow-repository >/dev/null 2>&1 && shallow=$(git rev-parse --is-shallow-repository)
now=${RASTRO_NOW:-$(date +%s)}

limit=$(rastro_config_get audit.under_review_days 2>/dev/null) || limit=""
case $limit in
  "" | *[!0-9]*) limit="" ;;
esac

boundary=$(rastro_config_list architecture.boundary_types 2>/dev/null) || boundary=""
seen=""
found=0
gp_metrics=""
item_events=""

# History rows of a golden path as "version<TAB>item": lines with 4 columns whose
# first column is X.Y.Z. Anything else is ignored.
gp_history() {
  tr -d '\r' <"$1" | awk '
    /^## / { on = ($0 == "## History"); next }
    on && /^\|/ {
      sub(/[ \t]+$/, "")
      n = split($0, c, "|")
      if (n != 6) next
      for (i = 2; i <= 5; i++) gsub(/^[ \t]+|[ \t]+$/, "", c[i])
      if (c[2] !~ /^[0-9]+\.[0-9]+\.[0-9]+$/) next
      printf "%s\t%s\n", c[2], c[4]
    }
  '
}

# gp_lifecycle FILE REL: records versions, contradictions and commits for one golden path.
gp_lifecycle() {
  local file=$1 rel=$2 v it versions=0 contra=0 commits name
  while IFS=$'\t' read -r v it; do
    [ -n "$v" ] || continue
    versions=$((versions + 1))
    if [ "$v" = 1.0.0 ]; then
      [ -z "$it" ] || item_events=$item_events$it$'\t'created$'\n'
    else
      [ -z "$it" ] || item_events=$item_events$it$'\t'evolved$'\n'
    fi
    if [[ $v =~ ^([0-9]+)\.0\.0$ ]] && [ "$((10#${BASH_REMATCH[1]}))" -gt 1 ]; then
      contra=$((contra + 1))
    fi
  done <<<"$(gp_history "$file")"
  if [ "$shallow" = true ]; then
    commits=-
  else
    commits=$(git log --oneline -- "$rel" 2>/dev/null | grep -c . || true)
  fi
  name=${rel##*/}
  gp_metrics=$gp_metrics"| ${name%.md} | $versions | $contra | $commits |"$'\n'
}

gp_audit() {
  local file=$1 rel=$2 dump key value type="" status="" instances="" has_instances=0
  local s inst path sha n ct age existing=0 detail
  dump=$(rastro_frontmatter_dump "$file" 2>/dev/null) || return 0
  while IFS=$'\t' read -r key value; do
    case $key in
      type) type=$value ;;
      status) status=$value ;;
      instances) has_instances=1; instances=$value ;;
    esac
  done <<<"$dump"
  found=1
  gp_lifecycle "$file" "$rel"

  if [ "$status" != retired ]; then
    sha=$(git log -1 --format=%H -- "$rel" 2>/dev/null) || sha=""
    if [ "$has_instances" -eq 1 ]; then
      rastro_frontmatter_split "$instances" && s=0 || s=$?
      if [ "$s" -eq 0 ]; then
        for inst in ${RASTRO_FM_ITEMS[@]+"${RASTRO_FM_ITEMS[@]}"}; do
          path=$(rastro_gp_instance_path "$inst")
          if [ ! -e "$root/$path" ]; then
            row instances-changed "$rel:$path" drift "instance does not exist"
          elif [ "$shallow" = true ]; then
            row instances-changed "$rel:$path" "NOT VERIFIED" "shallow clone; fetch the full history"
          elif [ -z "$sha" ]; then
            row instances-changed "$rel:$path" ok "golden path not committed yet"
          else
            n=$(git log --format=%h "$sha..HEAD" -- "$path" 2>/dev/null | grep -c . || true)
            if [ "$n" -gt 0 ]; then
              detail="$n commits touched it since $rel last changed (${sha:0:7})"
              [ "$n" -ne 1 ] || detail="1 commit touched it since $rel last changed (${sha:0:7})"
              row instances-changed "$rel:$path" drift "$detail"
            else
              row instances-changed "$rel:$path" ok "no commit touched it since $rel last changed (${sha:0:7})"
            fi
          fi
        done
      fi
    fi
  fi

  if [ "$status" = current ]; then
    if [ "$has_instances" -eq 1 ] && rastro_frontmatter_split "$instances"; then
      for inst in ${RASTRO_FM_ITEMS[@]+"${RASTRO_FM_ITEMS[@]}"}; do
        path=$(rastro_gp_instance_path "$inst")
        [ ! -e "$root/$path" ] || existing=$((existing + 1))
      done
    fi
    if [ "$existing" -eq 0 ]; then
      row no-instance "$rel" drift "no instance exists on disk"
    else
      row no-instance "$rel" ok "$existing instance(s) exist"
    fi
  fi

  if [ -n "$type" ] && [ "$status" != retired ]; then
    if s=$(rastro_gp_seen_find "$seen" "$type"); then
      row duplicate-type "$rel" drift "type $type already has golden path $s"
    else
      row duplicate-type "$rel" ok "type $type has one golden path"
    fi
    seen=$seen$type$'\t'$rel$'\n'
    if rastro_gp_list_has "$boundary" "$type"; then
      s=$(rastro_gp_security "$file")
      case $s in
        ok) row boundary-security "$rel" ok "security section lists threats" ;;
        *) row boundary-security "$rel" drift "$type is a boundary type and its security section is $s" ;;
      esac
    fi
  fi

  if [ "$status" = under-review ]; then
    ct=$(git log -1 --format=%ct -- "$rel" 2>/dev/null) || ct=""
    if [ "$shallow" = true ]; then
      row under-review-age "$rel" "NOT VERIFIED" "shallow clone; fetch the full history"
    elif [ -z "$ct" ]; then
      row under-review-age "$rel" ok "golden path not committed yet"
    else
      age=$(((now - ct) / 86400))
      if [ -z "$limit" ]; then
        row under-review-age "$rel" ok "age $age days, no limit set"
      elif [ "$age" -gt "$limit" ]; then
        row under-review-age "$rel" drift "age $age days, limit $limit"
      else
        row under-review-age "$rel" ok "age $age days, limit $limit"
      fi
    fi
  fi
}

gp_dir=$(rastro_gp_folder 2>/dev/null) && s=0 || s=$?
if [ "$s" -eq 0 ]; then
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    gp_audit "$file" "${file#"$root"/}"
  done <<<"$(rastro_gp_files "$root" "$gp_dir")"
else
  echo "audit-drift: architecture.golden_paths is in the old list form; no golden paths read" >&2
fi

commit=$(git rev-parse --short HEAD 2>/dev/null) || commit=none

printf '# Drift audit\n\n'
printf 'Date: %s\n' "$(date +%Y-%m-%d)"
printf 'Commit: %s\n\n' "$commit"
printf '## Mechanical checks\n\n'
if [ "$found" -eq 0 ]; then
  printf 'No golden paths.\n'
else
  printf '| Check | Subject | Verdict | Detail |\n'
  printf '|---|---|---|---|\n'
  printf '%s' "$rows"
fi
printf '\n'

printf '## Metrics\n\n'
ws=$(rastro_workspace 2>/dev/null) || ws=.agent/
ws=${ws%/}
rastro_metrics_lint_summary "$root/${ws:-.agent}/metrics/lint.log" | sed 's/^/- /'
printf '\n'
if [ "$found" -eq 0 ]; then
  printf 'No golden paths.\n'
else
  printf '| Golden path | Versions | Contradictions | Commits |\n'
  printf '|---|---|---|---|\n'
  printf '%s' "$gp_metrics"
  printf '\n'
  if [ -n "$item_events" ]; then
    printf '| Item | Golden paths created | Golden paths evolved |\n'
    printf '|---|---|---|\n'
    printf '%s' "$item_events" | awk -F'\t' '
      !($1 in seen) { seen[$1] = 1; order[++n] = $1 }
      $2 == "created" { c[$1]++ }
      $2 == "evolved" { e[$1]++ }
      END { for (i = 1; i <= n; i++) printf "| %s | %d | %d |\n", order[i], c[order[i]], e[order[i]] }
    '
  else
    printf 'No History entries.\n'
  fi
fi
printf '\nContradictions counts golden path changes decided as incompatible (a major version). A contradiction settled by changing the code leaves no trace in the repository and is not counted.\n\n'

# Rows of a report as "check subject<TAB>verdict<TAB>detail".
report_rows() {
  awk '
    /^## / { on = ($0 == "## Mechanical checks"); next }
    on && /^\| / && !/^\| Check \|/ && !/^\|---/ {
      n = split($0, c, / \| /)
      if (n < 4) next
      key = substr(c[1], 3) " " c[2]
      detail = c[4]
      sub(/ \|$/, "", detail)
      printf "%s\t%s\t%s\n", key, c[3], detail
    }
  '
}

printf '## Changes since the previous audit'
if [ -n "$previous" ] && [ -f "$previous" ]; then
  prev_date=$(sed -n 's/^Date: //p' "$previous" | head -n 1 | tr -d '\r')
  [ -z "$prev_date" ] || printf ' (%s)' "$prev_date"
  printf '\n\n'
  prev_rows=$(mktemp)
  cur_rows=$(mktemp)
  trap 'rm -f "$prev_rows" "$cur_rows"' EXIT
  tr -d '\r' <"$previous" | report_rows >"$prev_rows"
  { printf '## Mechanical checks\n'; printf '%s' "$rows"; } | report_rows >"$cur_rows"
  awk -F'\t' '
    FILENAME == ARGV[1] { pv[$1] = $2; next }
    { cv[$1] = $2; cd[$1] = $3; order[++n] = $1 }
    END {
      for (i = 1; i <= n; i++) {
        k = order[i]
        if (cv[k] == "drift" && pv[k] != "drift") printf "- new: %s: %s\n", k, cd[k]
      }
      for (k in pv) {
        if (pv[k] == "drift" && cv[k] != "drift") resolved[++m] = k
      }
      # sort resolved keys for a stable report
      for (i = 1; i <= m; i++)
        for (j = i + 1; j <= m; j++)
          if (resolved[j] < resolved[i]) { t = resolved[i]; resolved[i] = resolved[j]; resolved[j] = t }
      for (i = 1; i <= m; i++) printf "- resolved: %s\n", resolved[i]
      u = 0
      for (k in cv) if (cv[k] == "drift" && pv[k] == "drift") u++
      printf "- unchanged: %d drift(s)\n", u
    }
  ' "$prev_rows" "$cur_rows"
else
  printf '\n\nNo previous audit.\n'
fi

if [ "$fail_on_drift" -eq 1 ] && [ "$drifts" -gt 0 ]; then
  exit 1
fi
exit 0
