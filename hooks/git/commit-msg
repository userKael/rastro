#!/usr/bin/env bash
set -eu
lib=${RASTRO_LIB:-$(dirname "$0")/../lib}
. "$lib/config.sh"
. "$lib/commit.sh"
RASTRO_CONFIG=$(rastro_config_path) || exit 0

if [ $# -lt 1 ]; then
  echo "usage: commit-msg <message-file>" >&2
  exit 2
fi
header=""
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%$'\r'}
  case $line in
    '#'*) continue ;;
  esac
  [[ $line == *[![:space:]]* ]] || continue
  header=$line
  break
done <"$1"
[ -n "$header" ] || exit 0

rc=0
reason=$(rastro_check_header "$header" 2>&1) || rc=$?
case $rc in
  0) ;;
  1)
    printf 'rastro: commit message rejected: %s\n  header: %s\n' "$reason" "$header" >&2
    exit 1
    ;;
  *)
    printf '%s\n' "$reason" >&2
    exit "$rc"
    ;;
esac
