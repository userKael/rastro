#!/usr/bin/env bash
set -eu
lib=${RASTRO_LIB:-$(dirname "$0")/../lib}
. "$lib/config.sh"
. "$lib/paths.sh"
RASTRO_CONFIG=$(rastro_config_path) || exit 0

lint=$(rastro_config_get verify.lint)
typecheck=$(rastro_config_get verify.typecheck)
unit=$(rastro_config_get verify.unit)
integration=$(rastro_config_get verify.integration)

run_integration=0
globs=""
if [ -n "$integration" ]; then
  globs=$(rastro_config_list verify.integration_when)
fi
if [ -n "$integration" ] && [ -n "$globs" ]; then
  base=${1:-}
  [ -n "$base" ] || base=$(rastro_config_get project.base_branch)
  [ -n "$base" ] || base=main
  case $base in
    -*)
      echo "run-verify: base ref must not start with a dash: $base" >&2
      exit 2
      ;;
  esac
  changed=$(mktemp)
  trap 'rm -f "$changed"' EXIT
  if merge_base=$(git merge-base "$base" HEAD 2>/dev/null) &&
    git diff --name-only -z "$merge_base" -- >"$changed" 2>/dev/null; then
    while IFS= read -r -d '' path; do
      while IFS= read -r glob; do
        if rastro_glob_match "$path" "$glob"; then
          run_integration=1
          break
        fi
      done <<<"$globs"
      [ "$run_integration" -eq 0 ] || break
    done <"$changed"
  else
    echo "rastro: cannot diff against $base; running verify.integration" >&2
    run_integration=1
  fi
fi

if [ -z "$lint$typecheck$unit$integration" ]; then
  echo "rastro: no verify command configured; set at least one of verify.lint, verify.typecheck, verify.unit, verify.integration in .rastro/config.yml" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$root"

run_step() {
  local rc=0
  printf 'rastro: running %s: %s\n' "$1" "$2" >&2
  bash -c "$2" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'rastro: %s failed with exit %s\n' "$1" "$rc" >&2
    exit "$rc"
  fi
}

[ -z "$lint" ] || run_step verify.lint "$lint"
[ -z "$typecheck" ] || run_step verify.typecheck "$typecheck"
[ -z "$unit" ] || run_step verify.unit "$unit"
[ "$run_integration" -eq 0 ] || run_step verify.integration "$integration"
