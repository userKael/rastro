#!/usr/bin/env bash
set -eu
lib=${RASTRO_LIB:-$(dirname "$0")/../lib}
. "$lib/config.sh"
. "$lib/paths.sh"
RASTRO_CONFIG=$(rastro_config_path) || exit 0

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "usage: check-changed-paths <base-ref>" >&2
  exit 2
fi
case $1 in
  -*)
    echo "check-changed-paths: base ref must not start with a dash: $1" >&2
    exit 2
    ;;
esac

rastro_forbidden_load
changed=$(mktemp)
trap 'rm -f "$changed"' EXIT
git diff --name-only -z --diff-filter=ACMRT "$1...HEAD" -- >"$changed"
rc=0
rastro_report_forbidden "forbidden path changed" <"$changed" || rc=$?
if [ "$rc" -ne 0 ]; then
  echo "rastro: change set refused; see conventions.forbidden_paths and workspace in .rastro/config.yml" >&2
  exit "$rc"
fi
